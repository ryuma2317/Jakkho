# ==========================================
# Unity .gitignore for Jakkho VR Repository
# Supports both root and subfolder projects (SCEN3, Landing_Page)
# ==========================================

# Unity generated folders (matches root and any subfolder)
[Ll]ibrary/
**/[Ll]ibrary/
[Tt]emp/
**/[Tt]emp/
[Oo]bj/
**/[Oo]bj/
[Bb]uild/
**/[Bb]uild/
[Bb]uilds/
**/[Bb]uilds/
[Ll]ogs/
**/[Ll]ogs/
[Uu]ser[Ss]ettings/
**/[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
**/[Mm]emoryCaptures/
[Rr]ecordings/
**/[Rr]ecordings/

# Autogenerated IDE / Solution files
.vs/
**/.vs/
.idea/
**/.idea/
.gradle/
**/.gradle/
ExportedObj/
**/ExportedObj/
.consulo/
**/.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Unity generated meta files for deleted/temporary files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Blender autosave files
*.blend1
*.blend1.meta

# Crash logs & system info
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Build artifacts
*.apk
*.aab
*.app

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Addressables temp files
/[Aa]ssets/Addressables_Temp*
**/[Aa]ssets/Addressables_Temp*
GeneratedAssets/
**/GeneratedAssets/
