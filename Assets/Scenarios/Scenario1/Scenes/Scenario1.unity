  m_text: "<line-height=145%><color=#10B981><b>\u2713</b></color>  <b>Bank login
    credentials (ABA Bank)</b> \u2014 <color=#34D399><b>SECURED</b></color>\n<color=#10B981><b>\u2713</b></color> 
    <b>Work email password</b> \u2014 <color=#34D399><b>PROTECTED</b></color>\n<color=#10B981><b>\u2713</b></color> 
