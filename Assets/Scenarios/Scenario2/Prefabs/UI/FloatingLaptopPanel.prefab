  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=#FF9500>[SIMULATED ATTACKER INTERCEPT LOG]</color></b>\n\u2022
    <b>Rogue SSID:</b> Jakko-cooffee_free (Open / Unencrypted)\n\u2022 <b>Legitimate
    SSID:</b> Jakko-Coffee_5G (WPA2-PSK)\n\u2022 <b>Phishing Domain:</b> coffeeshop-free-login.example\n\u2022
    <b>Captured Account:</b> <color=#FF3B30>demo@example.test</color>\n\u2022 <b>Captured
    Password:</b> <color=#FF3B30>\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022</color>\n\n<b><color=#4CD964>[KEY
    TAKEAWAYS & DEFENSE]</color></b>\n1. <b>Evil Twin Attack:</b> Attackers clone
    public Wi-Fi names with subtle typos or '_free' suffixes.\n2. <b>Fake Portals:</b>
    Open networks can redirect all web traffic to fake login portals.\n3. <b>Protection:</b>
    Always confirm SSID and password with staff; use encrypted Wi-Fi (WPA2/3) or
    VPN."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
