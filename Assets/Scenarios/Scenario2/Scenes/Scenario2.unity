      m_Calls: []
  m_text: "\u2022 <b>SSID Spoofing:</b> Anyone can name their portable router or
    hotspot anything they want.\n\u2022 <b>Evil Twin Attack:</b> Attackers clone
    legitimate shop names to deceive nearby visitors.\n\u2022 <b>Nuanced Caution:</b>
    Open Wi-Fi is <i>not automatically malicious</i>, but unsecured networks offer
    zero identity verification or eavesdropping protection.\n\u2022 <b>Best Practice:</b>
    Always verify the exact network name and password with shop staff."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
