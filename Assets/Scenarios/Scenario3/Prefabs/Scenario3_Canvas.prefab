  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=22><color=#0277BD><b>Why Attackers Target Your Friends' Accounts</b></color></size>\n\nAttackers
    rarely send phishing links from unfamiliar strangers when targeting students
    or corporate teams. Instead, they first compromise one member of the group, then
    immediately abuse existing relationship trust to distribute lures.\n\n\u2022
    <b>Key Defense:</b> If a friend asks for urgent votes, survey fills, or verification
    codes, <b>always verify out-of-band</b> (e.g. voice call or face-to-face) before
    taking action."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f675742eaf9c20a4f909d78ee7a14fed, type: 2}
