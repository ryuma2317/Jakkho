  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=22><color=#0277BD><b>How QR Login Tokens Work</b></color></size>\n\nThe
    'Link Desktop Device' feature in Telegram, WhatsApp, and Signal is exclusively
    designed to authorize full desktop access to your messaging account.\n\n\u2022
    <b>The Scam:</b> Phishing portals disguise session-pairing QR codes as 'contest
    vote verifications' or 'identity checkmarks'.\n\n\u2022 <b>Crucial Rule:</b>
    <b>Never</b> use 'Link Device' on a web portal or third-party screen!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f675742eaf9c20a4f909d78ee7a14fed, type: 2}
