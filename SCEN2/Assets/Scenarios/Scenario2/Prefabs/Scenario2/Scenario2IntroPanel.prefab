  m_BackToMenuButton: {fileID: 208278914257160051}
  m_StoryTitle: SCENARIO 2
  m_StoryBody: 'You have just arrived at the cafe and begin

    taking customer
    orders.


    Everything seems normal until you notice

    a message from your
    boss.


    He needs an important financial report

    sent immediately because
    he has a meeting.


    The message was sent 17 minutes ago.


    You only have
    3 minutes left.'
  m_MainMenuSceneName: MainMenu
  OnScenarioStarted:
    m_PersistentCalls:
      m_Calls: []
